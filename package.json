{
	"name": "obsidian-download-tracker",
	"version": "0.2.0",
	"description": "Shows download counts for the Obsidian plugins and themes you publish, with dated snapshots.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"push-all": "git push origin main && git push github main"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"downloads",
		"statistics"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "5.0.3"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"fsevents": false
	},
	"author": "Anthony Fitzpatrick",
	"repository": "https://github.com/anthonyfitzpatrick/obsidian-download-tracker"
}
